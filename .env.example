# Server
PORT=3000
DATABASE_URL=            # Render Postgres internal URL in prod; empty = local embedded PGlite
ADMIN_PASSWORD=          # protects /admin
TOOL_SECRET=             # shared secret ElevenLabs sends as x-tool-secret header
PUBLIC_BASE_URL=         # e.g. https://callmentor.onrender.com

# Public contact points shown on the landing page
VOICE_NUMBER=
WHATSAPP_LINK=

# Pine Labs (test/UAT mode)
PINELABS_CLIENT_ID=
PINELABS_CLIENT_SECRET=
PINELABS_MID=
PINELABS_BASE_URL=
AGENT_SECRET=            # bearer token the AgenticOrg agent uses to call /api/agent/*
AGENTICORG_API_KEY=
GEMINI_API_KEY=           # Google AI Studio key; empty = deterministic fallback mode
GEMINI_MODEL=             # optional; used only if listed by ListModels
GROQ_API_KEY=             # optional second provider (console.groq.com)
AI_PROVIDERS=groq,gemini  # order to try (groq first: faster, larger free quota)
GEMINI_MODELS=            # optional comma list to pin preferred models (must be listed by the API)
ELEVENLABS_API_KEY=       # server-side only: signed voice session URLs
ELEVENLABS_AGENT_ID=      # agent created by scripts/setup-voice-agent.ts
VOICE_LLM_SECRET=         # bearer token ElevenLabs sends to /v1/chat/completions (same value as the ElevenLabs workspace secret)
